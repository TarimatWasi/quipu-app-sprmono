<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Reglas de la "Guía Spring" (Yachay Wasi) que verifica Checkstyle; el mapa está en la
     "Guía GitHub Actions y calidad de CI", sección 4.2. -->
<module name="Checker">
  <property name="severity" value="warning"/>
  <module name="SuppressionFilter">
    <property name="file" value="${checkstyle.suppressions.file}"/>
  </module>
  <!-- BE-SPR-COD-09 -->
  <module name="FileLength">
    <property name="max" value="800"/>
  </module>
  <module name="TreeWalker">
    <!-- BE-SPR-COD-09 -->
    <module name="MethodLength">
      <property name="max" value="50"/>
    </module>
    <module name="NestedIfDepth">
      <property name="max" value="4"/>
    </module>
    <module name="NestedTryDepth">
      <property name="max" value="4"/>
    </module>
    <!-- BE-SPR-DI-05 -->
    <module name="ParameterNumber">
      <property name="max" value="7"/>
    </module>
    <!-- BE-SPR-COD-02 -->
    <module name="IllegalImport">
      <property name="illegalPkgs" value="lombok"/>
    </module>
    <!-- BE-SPR-COD-05 -->
    <module name="IllegalCatch">
      <property name="illegalClassNames" value="Exception, Throwable, RuntimeException"/>
    </module>
    <!-- BE-SPR-COD-10 -->
    <module name="TodoComment">
      <property name="format" value="(TODO|FIXME)(?!\([A-Z][A-Z0-9]*-[0-9]+\))"/>
    </module>
    <!-- BE-SPR-EST-02 -->
    <module name="TypeName"/>
    <module name="MethodName"/>
    <module name="MemberName"/>
    <module name="ParameterName"/>
    <module name="LocalVariableName"/>
    <module name="ConstantName"/>
    <module name="PackageName"/>
    <!-- BE-SPR-EST-06 -->
    <module name="OneTopLevelClass"/>
    <!-- BE-SPR-EST-03: solo en port/in (ver checkstyle-suppressions.xml) -->
    <module name="MissingJavadocType">
      <property name="scope" value="public"/>
    </module>
    <module name="MissingJavadocMethod">
      <property name="scope" value="public"/>
    </module>
    <module name="UnusedImports"/>
    <module name="RedundantImport"/>
    <!-- BE-SPR-EST-04: tipos por import explícito; ni comodines ni nombres totalmente calificados
         en el código (los strings y comentarios quedan fuera de la regla). -->
    <module name="AvoidStarImport"/>
  </module>
  <!-- OPS-GHA-CI-05 (TAR-384): una supresión cita en su línea el ID de la regla y la tarea. -->
  <module name="RegexpSingleline">
    <property name="id" value="SuppressionWithoutRuleAndTask"/>
    <property name="format"
        value="(@SuppressWarnings|NOSONAR)(?!.*(([A-Z]{2,}(-[A-Z0-9]+)+-\d+|java:S\d+).*TAR-\d+|TAR-\d+.*([A-Z]{2,}(-[A-Z0-9]+)+-\d+|java:S\d+)))"/>
    <property name="fileExtensions" value="java"/>
    <property name="message"
        value="Supresión sin el ID de la regla y la tarea en su línea (OPS-GHA-CI-05)."/>
  </module>
  <module name="RegexpSingleline">
    <property name="id" value="FullyQualifiedName"/>
    <property name="format"
        value="^(?!\s*(import|package)\s)(?!\s*(//|\*|/\*))(?:[^&quot;\n]|&quot;(?:[^&quot;\\]|\\.)*&quot;)*?(?&lt;![\w.])(java|javax|jakarta|org|com|io|tools)\.[a-z][a-z0-9_]*(\.[a-z][a-z0-9_]*)*\.[A-Z]"/>
    <property name="fileExtensions" value="java"/>
    <property name="message"
        value="Nombre totalmente calificado: importar el tipo (BE-SPR-EST-04)."/>
  </module>
</module>
